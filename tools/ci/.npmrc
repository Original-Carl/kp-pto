engine-strict=true
# Install exact versions, not ranges.
save-exact=true
# Don't resolve package versions published less than 7 days ago (malicious
# releases are usually caught and pulled within days). For an urgent security
# fix, exempt that one package: min-release-age-exclude=<pkg>
min-release-age=7
# Security-fix exemption (2026-10-23, approved by Carl): fast-uri 3.1.9 fixes
# GHSA-333x-w4r6-6crp, GHSA-w74x-v6f9-j3xg, GHSA-wjr9-j795-jxcr, GHSA-xhq7-xmqj-769h
# but was only 4 days old. Remove this line after 2026-10-26, when 3.1.9 is 7 days old.
min-release-age-exclude=fast-uri
